// Generated integration driver. Replaces cmd/compile/main.go in an isolated tree.
package main

import (
    "cmd/compile/internal/amd64"
    "cmd/compile/internal/arm64"
    "cmd/compile/internal/base"
    "cmd/compile/internal/ssagen"
    "cmd/compile/internal/ssa"
    "cmd/internal/obj"
    "cmd/internal/objabi"
    "context"
    "encoding/json"
    "flag"
    "fmt"
    "go-backend-ssa/compiler"
    "internal/buildcfg"
    "io/fs"
    "log"
    "os"
    "os/exec"
    "io"
    "strings"
    "time"
    "go-backend-ssa/diagnostic"
    "runtime"
)

const bridgeRevision = "{{CONTENT_HASH}}"

func main() {
    log.SetFlags(0)
    log.SetPrefix("compile: ")
    if err := run(); err != nil {
        if diagnostics, ok := err.(*compiler.Error); ok {
            fmt.Fprintln(os.Stderr, diagnostics)
            base.ErrorExit()
        }
        fmt.Fprintln(os.Stderr, "compile:", err)
        os.Exit(1)
    }
}

func run() error {
    // cmd/go hashes this identity into its build cache. It must differ from
    // the original compiler and change with the complete vendored library.
    for _, arg := range os.Args[1:] {
        if arg == "-V" || arg == "-V=full" {
            fmt.Printf("compile version %s (go-backend-ssa %s)\n", compiler.Version, bridgeRevision)
            return nil
        }
    }
    buildcfg.Check()
    if buildcfg.GOOS != "linux" || (buildcfg.GOARCH != "amd64" && buildcfg.GOARCH != "arm64") {
        return fmt.Errorf("go-backend-ssa currently supports linux/amd64 and linux/arm64, got %s/%s", buildcfg.GOOS, buildcfg.GOARCH)
    }
    // Retain the official driver parser, config-file readers and diagnostics.
    // This native graph is used only to parse driver settings. Source loading
    // and every compiler pass run exclusively through compiler.Compile below.
    if buildcfg.GOARCH == "amd64" { amd64.Init(&ssagen.Arch) } else { arm64.Init(&ssagen.Arch) }
    base.Ctxt = obj.Linknew(ssagen.Arch.LinkArch)
    base.Ctxt.DiagFunc = base.Errorf
    base.Ctxt.DiagFlush = base.FlushErrors
    base.Ctxt.UseBASEntries = base.Ctxt.Headtype != objabi.Hdarwin
    base.DebugSSA = ssa.PhaseOption
    base.ParseFlags()
    supported := map[string]bool{
        "e": true, "C": true, "L": true, "spectre": true, "clobberdead": true, "clobberdeadreg": true,
        "p": true, "o": true, "lang": true, "std": true, "+": true,
        "complete": true, "buildid": true, "goversion": true,
        "trimpath": true, "nolocalimports": true, "D": true,
        "importcfg": true, "embedcfg": true, "symabis": true,
        "pack": true, "asmhdr": true, "c": true, "N": true, "pgoprofile": true,
        "l": true, "dwarf": true, "race": true, "installsuffix": true, "shared": true, "S": true, "d": true, "m": true,
    }
    var unsupported string
    flag.Visit(func(f *flag.Flag) { if !supported[f.Name] && unsupported == "" { unsupported = f.Name } })
    if unsupported != "" { return fmt.Errorf("unsupported go-backend-ssa compiler option -%s", unsupported) }
    if base.Ctxt.Pkgpath == obj.UnlinkablePkg { return fmt.Errorf("go-backend-ssa driver currently requires an explicit -p package path") }
    if base.Flag.N != 0 && base.Flag.N != 1 { return fmt.Errorf("unsupported optimization mode -N=%d",base.Flag.N) }
    if base.Flag.LowerL != 0 && base.Flag.LowerL != 1 { return fmt.Errorf("unsupported inline mode -l=%d", base.Flag.LowerL) }
    target := compiler.Target{GOOS: buildcfg.GOOS, GOARCH: buildcfg.GOARCH, Experiments: buildcfg.Experiment.String()}
    if buildcfg.GOARCH == "amd64" { target.GOAMD64 = buildcfg.GOAMD64 } else { target.GOARM64 = buildcfg.GOARM64.String() }
    req := compiler.Request{
        ImportPath: base.Ctxt.Pkgpath,
        Target: target,
        Paths: compiler.SourcePaths{WorkingDirectory: base.Ctxt.Pathname, GOROOT: buildcfg.GOROOT, HostOS: runtime.GOOS},
        Options: compiler.Options{
            UnlimitedErrors: base.Flag.LowerE != 0, OmitErrorColumns: base.Flag.C != 0, ActualErrorFiles: base.Flag.L == 1,
            AssemblyListing: int(base.Flag.S), OptimizationReport: int(base.Flag.LowerM),
            Spectre: base.Flag.Spectre, ClobberDead: base.Flag.ClobberDead, ClobberDeadReg: base.Flag.ClobberDeadReg,
            Race: base.Flag.Race, Shared: *base.Flag.Shared, InstallSuffix: base.Flag.InstallSuffix,
            Workers: base.Flag.LowerC, DisableOptimization: base.Flag.N != 0,
            DisableInlining: base.Flag.LowerL == 1, DisableDwarf: !base.Flag.Dwarf,
            Complete: base.Flag.Complete, Standard: base.Flag.Std, CompilingRuntime: base.Flag.CompilingRuntime,
            AssemblyHeader: base.Flag.AsmHdr != "", NoLocalImports: base.Flag.NoLocalImports,
            Language: base.Flag.Lang, BuildID: base.Flag.BuildID, TrimPath: base.Flag.TrimPath, LocalImportPrefix: base.Flag.D,
        },
        ImportLoaders: map[string]compiler.ImportLoader{}, ImportMap: base.Flag.Cfg.ImportMap,
        Embed: compiler.EmbedConfig{Patterns: base.Flag.Cfg.Embed.Patterns, Files: base.Flag.Cfg.Embed.Files, Open: func(path string)(fs.File,error){ return os.Open(path) }},
    }
    req.Debug = compiler.DebugOptions{
        Flags: debugSettings(os.Args[1:], os.Getenv("GOCOMPILEDEBUG")),
        ClobberDeadHash: os.Getenv("GOCLOBBERDEADHASH"),
        Function: os.Getenv("GOSSAFUNC"), Directory: os.Getenv("GOSSADIR"),
        OpenFile: func(path string, flags int, mode fs.FileMode)(io.WriteCloser,error){return os.OpenFile(path,flags,mode)},
        MakeDirectory: os.MkdirAll, OpenSource: func(path string)(io.ReadCloser,error){return os.Open(path)},
        ExpandSourcePath: os.ExpandEnv, Now: time.Now, ReadMemStats: runtime.ReadMemStats,
        LookPath: exec.LookPath, Command: exec.Command,
    }
    for _, name := range flag.Args() {
        data, err := os.ReadFile(name); if err != nil { return err }
        req.Files = append(req.Files, compiler.SourceFile{Name: name, Data: data})
    }
    for path, name := range base.Flag.Cfg.PackageFile {
        req.ImportLoaders[path] = func(context.Context) ([]byte,error) { return os.ReadFile(name) }
    }
    if base.Flag.SymABIs != "" {
        data, err := os.ReadFile(base.Flag.SymABIs); if err != nil { return err }; req.SymABIs = data
    }
    if base.Flag.PgoProfile != "" {
        data, err := os.ReadFile(base.Flag.PgoProfile); if err != nil { return err }
        req.PGOProfile = &compiler.ProfileInput{Name: base.Flag.PgoProfile, Data: data}
    }
    result, err := compiler.Compile(context.Background(), req)
    if err != nil { return err }
    if _, err = os.Stdout.Write(result.DebugOutput); err != nil { return err }
    if _, err = os.Stdout.Write(result.AssemblyListing); err != nil { return err }
    for _, d := range result.Diagnostics { if d.Severity != diagnostic.Warning { fmt.Fprintln(os.Stderr, d.String()) } }
    if err = os.WriteFile(base.Flag.LowerO, result.Archive, 0666); err != nil { return err }
    if base.Flag.AsmHdr != "" {
        if err = os.WriteFile(base.Flag.AsmHdr, result.AssemblyHeader, 0666); err != nil { return err }
    }
    // Explicit opt-in audit evidence records successful calls into the library.
    if path := os.Getenv("GO_SSA_BRIDGE_TRACE"); path != "" {
        record, err := json.Marshal(struct{ Package, Library, Upstream, Profile string; Files []string }{req.ImportPath, bridgeRevision, compiler.UpstreamCommit, base.Flag.PgoProfile, flag.Args()}); if err != nil { return err }
        f, err := os.OpenFile(path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0600); if err != nil { return err }
        _, err = f.Write(append(record, '\n')); closeErr := f.Close(); if err != nil { return err }; return closeErr
    }
    return nil
}

// The native parser validates these settings; its String method is empty.
// Retain only the ordered -d payloads for replay into the owned compiler graph.
func debugSettings(args []string, environment string) []string {
    var settings []string
    for i:=0;i<len(args);i++ {
        arg:=args[i]
        if arg=="--" || !strings.HasPrefix(arg,"-") {break}
        arg=strings.TrimPrefix(strings.TrimPrefix(arg,"-"),"-")
        key,value,equals:=strings.Cut(arg,"=")
        if key=="d" {if !equals {i++;value=args[i]};settings=append(settings,value);continue}
        // flag.Parse consumes the following word for non-boolean flags.
        if !equals {if f:=flag.Lookup(key);f!=nil {if boolean,ok:=f.Value.(interface{IsBoolFlag()bool});!ok||!boolean.IsBoolFlag(){i++}}}
    }
    if environment!="" {settings=append(settings,environment)}
    return settings
}
